=== pirate_npc_smuggle_resource
metadata: ```
type: objective
```
  object_id = OBJECTIVE.get_inventory_value("objective:goto_object")
  if object_id is None:
    object_ids = all_roles("station,pirate") - broad_test_around(OBJECTIVE_AGENT_ID, 900,900)
    OBJECTIVE.set_inventory_value("desc", "")
  if OBJECTIVE.get_inventory_value("desc") == "":
    obj = to_object(object_id)
    if obj is not None:
      OBJECTIVE.set_inventory_value("desc", f"Smuggling resources to {obj.name}")
      OBJECTIVE.set_inventory_value("cover_desc", f"Heading to {obj.name}")
  jump goto_random_object

