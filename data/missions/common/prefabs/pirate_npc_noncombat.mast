default shared SHIP_NAME_DATA = load_json_data(get_mission_dir_filename("shipnames.json"))
default shared CIVILIAN_CALLSIGN_UNIQUE_NUMBER = random.randrange(0, 1200)

=== prefab_npc_pirate_noncombat_common
    
    civ_name = get_civilian_callsign_and_name()
    
    friend = to_object(npc_spawn(START_X, START_Y, START_Z, civ_name, side+",friendly,civilian,pirate", ship_art, "behav_npcship"))
    set_face(friend.id, random_terran(civilian=True))
    friend.data_set.set("ally_list",allies,0)
    friend.data_set.set("radar_color_override", color_map_pirate_npc())
    
    brain_add(friend.id, brain)
    objective_add(friend.id, objective)
    yield result friend.id

