=== docking_check_permissions ===
    
    # Currently, the only way to trigger an arbitrary comms response upon each
    # dock attempt is to let the tractor beam activate, and then potentially
    # cancel it.
    # It would be nice if dock attempts that fail because the '+++ enable'
    # task did `yield fail` could trigger arbitrary mission script code.
    # This would prevent the tractoring sound from playing on failed dock
    # attempts, and just be more performant and elegant (b/c it removes
    # unnecessary operations).
    # So if that ever becomes possible, then this code should do that instead.
    
    dock_attempt_result = test_player_capital_ship_dock(DOCKING_PLAYER_ID, DOCKING_NPC_ID)
    if is_dock_attempt_result_allowed(dock_attempt_result):
        set_weapons_selection(DOCKING_PLAYER_ID, 0)
        yield result True
    
    # failure; send reason in comms message
    with comms_override(DOCKING_PLAYER_ID, DOCKING_NPC_ID, from_name="Docking"):
        if dock_attempt_result == dock_attempt_result_disallowed_enemy_near():
            <<[red,white] "Enemies Near"
                % Attempting dock when enemies are near is ill advised.
            comms_broadcast(DOCKING_PLAYER_ID, "Docking denied, enemy nearby.")
        elif dock_attempt_result == dock_attempt_result_disallowed_piracy():
            <<[red,white] "Docking Clearance Denied"
                % You are not welcome here, pirate. We will not allow you to dock.
                % We're still trying to catalogue everything you stole last time!
                % Find somewhere else to dock, pirate scallywags!
                % We'd like to keep our stuff, it's got our name on it and everything.
                % Illegal seizure of mercantile goods is prohibited by the TSN charter.
                % We've heard about your ship's reputation, and we do not approve.
            comms_broadcast(DOCKING_PLAYER_ID, "Docking denied, pirate scum!")
        elif dock_attempt_result == dock_attempt_result_disallowed_pirate_killed_tsn():
            <<[red,white] "Docking Clearance Denied Forever"
                % We do not assist war criminals. Go away.
                % Over my dead body, you backstabbing marauder!
                % There will be no murderous pirates docking at my station!
                % Your crimes will not be forgotten. We will not help you.
                % You kill good friends of mine, then have the audacity to beg for docking clearance?
            comms_broadcast(DOCKING_PLAYER_ID, "Docking denied, traitors!")
        elif dock_attempt_result == dock_attempt_result_disallowed_always_hostile():
            <<[red,white] "Docking Clearance Denied"
                % Why are you even asking?
                % No, I'm not that stupid.
                % No tractor beams for you; only phaser beams!
                % Only if you surrender the fight first.
                % I wouldn't open a door for my foe.
            comms_broadcast(DOCKING_PLAYER_ID, "Docking denied, enemy!")
        elif dock_attempt_result == dock_attempt_result_disallowed_military_unwelcome():
            <<[red,white] "Docking Clearance Denied"
                % Don't you have your own starbases to help you out?
                % Last time I let a navy ship dock, I got loo cleaning duty for a month. I won't make that mistake again.
                % Military vessels are not welcome here.
                % We are not under your jurisdiction. Please go away.
                % As per the TSN military charter section 452 part 98c, civilian establishments cannot be required to quarter soldiers or otherwise give them aid. We invoke that right and wish you a good day, sir!
            comms_broadcast(DOCKING_PLAYER_ID, "Docking denied, officer.")
        elif dock_attempt_result == dock_attempt_result_disallowed_civilian_unwelcome():
            <<[red,white] "Docking Clearance Denied"
                % You would probably just get in the way.
                % We don't just give away our protection to anyone who asks for it.
                % Sheltering you would be more trouble than it's worth.
            comms_broadcast(DOCKING_PLAYER_ID, "Docking denied, civilian.")
    
    yield result False

=== refit_refill_torps ===
    if get_counter_elapsed_seconds(DOCKING_PLAYER_ID,"torps") >= torps_delay:
        start_counter(DOCKING_PLAYER_ID,"torps")
        
        cleared_ordinance_types = []
        for ordinance_type in npc_blob.get("torpedo_types_available", 0).strip(',').split(','):
            if ordinance_type == "Nuke" and not can_give_nukes(DOCKING_PLAYER_ID, DOCKING_NPC_ID):
                continue
            elif ordinance_type == "Mine" and not can_give_mines(DOCKING_PLAYER_ID, DOCKING_NPC_ID):
                continue
            cleared_ordinance_types.append(ordinance_type)
        
        for torps in cleared_ordinance_types:
            tLeft = npc_blob.get(f"{torps}_NUM", 0)
            if tLeft is not None and tLeft > 0:
                torp_max = player_blob.get(f"{torps}_MAX", 0)
                if torp_max is None:
                    torp_max = 10
                torp_now = player_blob.get(f"{torps}_NUM", 0)
                if torp_now < torp_max:
                    torp_now = torp_now + 1
                    player_blob.set(f"{torps}_NUM", torp_now,0)
                    npc_blob.set(f"{torps}_NUM", tLeft-1, 0)

