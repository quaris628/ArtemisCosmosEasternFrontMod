# The "tsn" role isn't assigned to these killed tsn ships, at least at the time this event runs
//damage/killed if is_tsn(DAMAGE_SELECTED_ID) or is_neutral_civilian(DAMAGE_SELECTED_ID)
    destroyed_by_ship_id = get_player_capital_ship_attributed_to_damage(DAMAGE_SOURCE_ID, DAMAGE_PARENT_ID)
    
    if destroyed_by_ship_id is not None and not has_killed_tsn(destroyed_by_ship_id):
        old_docking_privileges = test_player_capital_pirate_ship_dock_at_tsn(destroyed_by_ship_id)
        set_killed_tsn(destroyed_by_ship_id)
        
        if old_docking_privileges == dock_attempt_result_allowed_pirate_uneasy_alliance() or old_docking_privileges == dock_attempt_result_disallowed_piracy():
            # Send the "Desperate plea" message, and then station admin message
            await task_schedule(send_desperate_plea_message, data={"DESTROYED_ID": DAMAGE_SELECTED_ID})
            set_already_sent_desperate_plea(DAMAGE_SELECTED_ID)
            # Must wait for the engine to process the desperate plea message,
            # otherwise it might appear after the station admin message.
            await delay_sim(0.1)
            
            if old_docking_privileges == dock_attempt_result_allowed_pirate_uneasy_alliance():
                send_tsn_admin_comms_message(destroyed_by_ship_id, "Banned from Docking", "Good lord, you've destroyed a friendly vessel! I told them we should never trust filthy pirates! DOCKING PRIVILEGES REVOKED!")
            elif old_docking_privileges == dock_attempt_result_disallowed_piracy():
                send_tsn_admin_comms_message(destroyed_by_ship_id, "Banned from Docking", "Good lord, you've destroyed a friendly vessel! Any hope we had of working together is gone. DOCKING PERMANENTLY PROHIBITED!")
    
    ->END

//damage/killed if has_any_role(DAMAGE_SELECTED_ID, "raider, tsn, civilian")
    #
    # Don't spawn a wreck in a black hole
    #
    ->END if EVENT.sub_tag == "maelstrom"

    # When an enemy ship is destroyed, we want to replace it with a wreck. Before we delete the enemy, we need to 
    # grab a few things from it: the x/y/z position, and the side value, so we can determine later what type of 
    # upgrade it might drop. 

    ->END if DAMAGE_SELECTED_ID == 0
    dest_obj = to_object(DAMAGE_SELECTED_ID)
    ->END if dest_obj is None

    if has_role(DAMAGE_SELECTED_ID, "raider"):
        destroyed_by_ship_id = get_player_capital_ship_attributed_to_damage(DAMAGE_SOURCE_ID, DAMAGE_PARENT_ID)
        if destroyed_by_ship_id is not None:
            old_docking_privileges = test_player_capital_pirate_ship_dock_at_tsn(destroyed_by_ship_id)
            if old_docking_privileges == dock_attempt_result_disallowed_pirate_killed_tsn():
                send_tsn_admin_comms_message(destroyed_by_ship_id, "No Docking Clearance", "Your treachery won't be forgotten, no matter how many enemies you kill for us. You still can't dock with us.")
            if not has_killed_raider(destroyed_by_ship_id):
                set_killed_raider(destroyed_by_ship_id)
                if old_docking_privileges == dock_attempt_result_disallowed_piracy():
                    send_tsn_admin_comms_message(destroyed_by_ship_id, "Docking Clearance Granted", "You seem to be on our side, and we want to work together to protect this sector. You may dock with stations for supplies. But no funny business.")
    
    dest_side = dest_obj.side
    dest_origin = dest_obj.origin
    dest_key = dest_obj.art_id

    dest_eobj = to_engine_object(DAMAGE_SELECTED_ID)
    dest_posx = int(dest_eobj.pos.x)
    dest_posy = int(dest_eobj.pos.y)
    dest_posz = int(dest_eobj.pos.z)
    dest_data = ship_data_get_ship_data_for(dest_key)
    
    dest_hull = None
    if dest_data is not None:
        dest_hull = dest_data.get('hullpoints',0)

    # Not all destroyed ships leave behind wrecks. So here's some code to determine if a wreck is left behind.
    # Smaller hulls should have a lower chance, while bigger ships are more likely to leave behind wrecks.
    # Basic chance, cruiser = 40%, battleship = 60%, carrier/dreadnought = 80%

    dest_rand = random.randint(1,10)
    dest_chance = 0

    if dest_hull is None:
        dest_chance = 7
    elif dest_hull >= 2 and dest_hull <= 4:
        dest_chance = 4
    elif dest_hull >=5 and dest_hull <=7:
        dest_chance = 6
    elif dest_hull >= 8 and dest_hull <= 99:
        dest_chance = 8
        

    
    ->END if dest_rand > dest_chance

    # If dest_rand is lower than dest_chance, a wreck is created at the same position as the destroyed ship. 
    
    spawn_wreck(dest_eobj.pos, dest_origin, dest_hull)
    
    ->END

